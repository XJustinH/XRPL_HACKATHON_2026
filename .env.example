# Placeholders only. Copy to .env for local development. Never commit real values.
# Secrets are server-only: do not move any secret behind a NEXT_PUBLIC_ prefix.

# Public, non-secret network label shown in the UI.
NEXT_PUBLIC_XRPL_NETWORK_LABEL=XRPL Testnet

# --- Database (Agent A) ---
# Local default matches docker-compose.yml. Deployed environments set their own value.
DATABASE_URL=postgresql://xrpl:xrpl_local_only@localhost:5432/xrpl_ticketing
# Used only by `npm run test:db`; must be a separate *_test database (tests truncate it).
TEST_DATABASE_URL=postgresql://xrpl:xrpl_local_only@localhost:5432/xrpl_ticketing_test

# --- App / sessions (Agent A) ---
APP_BASE_URL=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# Allow signing in as seeded demo accounts without a wallet. Default: on outside production,
# off in production unless set to true (e.g. for the judges' demo deployment).
DEMO_LOGIN_ENABLED=

# --- XRPL (Agent B). Testnet only during the hackathon. See docs/xrpl/testnet.md. ---
# testnet (default) or devnet. Mainnet values are rejected, and every node must report
# the matching network_id before the app uses it.
XRPL_NETWORK=testnet
# Leave the rest blank to use the selected network's defaults (Testnet shown):
#   XRPL_WS_URL            wss://s.altnet.rippletest.net:51233/
#   XRPL_WS_FALLBACK_URLS  wss://testnet.xrpl-labs.com/   (comma-separated; "none" = no fallback)
#   XRPL_CLIO_WS_URL       wss://clio.altnet.rippletest.net:51233/   ("none" = disable Clio lookups)
#   XRPL_RPC_URL           https://s.altnet.rippletest.net:51234/
#   XRPL_EXPLORER_URL      https://testnet.xrpl.org
#   XRPL_REQUEST_TIMEOUT_MS / XRPL_CONNECT_TIMEOUT_MS   10000 / 5000
XRPL_WS_URL=
XRPL_WS_FALLBACK_URLS=
XRPL_CLIO_WS_URL=
XRPL_RPC_URL=
XRPL_EXPLORER_URL=
XRPL_REQUEST_TIMEOUT_MS=
XRPL_CONNECT_TIMEOUT_MS=

# --- Wallet signing provider (Agent B) ---
XAMAN_API_KEY=
XAMAN_API_SECRET=

# --- Object storage / metadata hosting (Agents B + E) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
PUBLIC_ASSET_BASE_URL=

# --- Optional integrations; leave blank unless explicitly enabled ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
NOTIFICATION_PROVIDER_API_KEY=
