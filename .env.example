# Copy to .env for local development. Never commit real values.
# All values here are server-only. Do not add NEXT_PUBLIC_ to any secret.

# --- Database (Agent A) ---
# Local default matches docker-compose.yml. Deployed environments set their own value.
DATABASE_URL=postgresql://xrpl:xrpl_local_only@localhost:5432/xrpl_ticketing
# Used only by `npm run test:db`; it is reset on every run.
TEST_DATABASE_URL=postgresql://xrpl:xrpl_local_only@localhost:5432/xrpl_ticketing_test

# --- App / sessions (Agent A) ---
APP_BASE_URL=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# --- XRPL (Agent B). Testnet only during the hackathon. ---
XRPL_NETWORK=testnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233/
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/

# --- Wallet signing provider (Agent B) ---
XAMAN_API_KEY=
XAMAN_API_SECRET=

# --- Object storage / metadata hosting (Agents B + E) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
PUBLIC_ASSET_BASE_URL=

# --- Optional integrations; leave blank unless explicitly enabled ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
NOTIFICATION_PROVIDER_API_KEY=
