// Core data model for the NFT ticketing MVP (XRPL-005).
// Owner: Agent A. Other agents request changes; do not add parallel migrations.
//
// Source-of-truth rules (see docs/architecture.md):
// - XRPL is authoritative for NFT identity, current owner and offer state.
// - Columns prefixed `cached` / `lastSynced*` are a read cache for speed and analytics only.
// - XRP amounts are integer drops stored as decimal strings (CHECK constraints in the migration).
// - All timestamps are timestamptz (UTC).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  SELLER
  ORGANISER
}

enum XrplNetwork {
  TESTNET
  DEVNET
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

/// Lifecycle of a ticket NFT mint. MINTED only after a validated tesSUCCESS NFTokenMint.
enum MintStatus {
  PENDING
  SUBMITTED
  MINTED
  FAILED
}

/// How fresh the cached on-chain view of a row is. Never a substitute for a ledger read.
enum SyncStatus {
  UNSYNCED
  SYNCED
  STALE
  ERROR
}

enum OfferKind {
  PRIMARY
  RESALE
  PRIVATE
  GIFT
}

enum OfferState {
  /// App created an intent; wallet has not signed / tx not validated yet.
  PENDING_SIGNATURE
  /// NFTokenCreateOffer validated; offer exists on ledger.
  ACTIVE
  /// NFTokenAcceptOffer validated.
  ACCEPTED
  CANCELLED
  EXPIRED
  /// Creation tx rejected, expired or failed on ledger.
  FAILED
  /// Offer no longer valid on ledger (e.g. NFT moved) but not explicitly cancelled.
  STALE
}

enum LedgerTxStatus {
  /// Hash known (or sign request created) but not yet in a validated ledger.
  PENDING
  /// validated === true and TransactionResult === tesSUCCESS.
  VALIDATED_SUCCESS
  /// validated === true and TransactionResult !== tesSUCCESS.
  VALIDATED_FAILURE
  /// Never validated before LastLedgerSequence / rejected by signer.
  DROPPED
}

enum LedgerTxType {
  NFTokenMint
  NFTokenCreateOffer
  NFTokenAcceptOffer
  NFTokenCancelOffer
  Payment
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String    @id @default(uuid()) @db.Uuid
  role        UserRole  @default(CUSTOMER)
  displayName String
  /// Non-sensitive preferences only (UI, opt-ins). Never secrets or tokens.
  settings    Json      @default("{}")
  /// Role chosen and profile completed (XRPL-010). Null for a wallet-first account still choosing a role.
  onboardedAt DateTime? @db.Timestamptz(3)
  /// Seeded demo persona (XRPL-008). Only these accounts can be assumed via demo login, and only when enabled.
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  wallets               WalletLink[]
  sessions              Session[]
  events                Event[]            @relation("EventSeller")
  checkInsScanned       CheckInRecord[]    @relation("CheckInOrganiser")
  offersCreated         NFTOffer[]         @relation("OfferCreatedBy")
  reviews               Review[]           @relation("ReviewAuthor")
  friendConnectionsLow  FriendConnection[] @relation("FriendLow")
  friendConnectionsHigh FriendConnection[] @relation("FriendHigh")
  blocksMade            UserBlock[]        @relation("Blocker")
  blocksReceived        UserBlock[]        @relation("Blocked")
  products              PhysicalProduct[]  @relation("ProductSeller")

  @@index([isDemo])
}

enum SessionMethod {
  /// Created while choosing a role at /onboarding.
  ONBOARDING
  /// Assumed a seeded demo persona (demo login enabled only).
  DEMO_PERSONA
  /// Signed in by proving control of an XRPL wallet (XRPL-012).
  WALLET
}

/// Server-side session (XRPL-010). The browser cookie holds a random 256-bit token;
/// only its SHA-256 hash is stored, so a database read does not yield usable cookies.
model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  tokenHash        String        @unique
  method           SessionMethod
  /// Wallet whose control was proven IN THIS SESSION (XRPL-012). Null = no proof yet.
  /// Session-scoped on purpose: a shared demo persona never inherits someone else's proof.
  walletAddress    String?
  walletVerifiedAt DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime      @db.Timestamptz(3)
  revokedAt        DateTime?     @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletProofs WalletProof[]

  @@index([userId])
  @@index([expiresAt])
}

/// A wallet sign-in proof request (XRPL-012), created by this server through the wallet
/// provider (a Xaman SignIn). Single-use and short-lived, and bound to the browser that asked
/// for it: only the SHA-256 of a random token held in that browser's httpOnly cookie is stored.
/// The signed blob itself carries the provider request ID (memo `xaman-signin`).
model WalletProof {
  id               String      @id @default(uuid()) @db.Uuid
  /// Wallet provider request ID (Xaman payload UUID), also embedded in the signed blob's memo.
  signRequestId    String      @unique
  network          XrplNetwork @default(TESTNET)
  /// SHA-256 (hex) of the random token in the requesting browser's httpOnly cookie.
  browserTokenHash String
  /// When set, only this address may complete the proof.
  requestedAddress String?
  /// Session that requested it, if any (audit only; binding uses browserTokenHash).
  sessionId        String?     @db.Uuid
  /// Address that signed, recorded when the proof is consumed.
  signerAddress    String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime    @db.Timestamptz(3)
  consumedAt       DateTime?   @db.Timestamptz(3)

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

/// A classic address linked to a user. A row with verifiedAt = null proves nothing:
/// control is only established by a wallet-signed challenge (XRPL-012).
model WalletLink {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @db.Uuid
  network              XrplNetwork @default(TESTNET)
  address              String
  verifiedAt           DateTime?   @db.Timestamptz(3)
  /// e.g. "xaman-signin"
  verificationProvider String?
  /// Provider payload/session reference for audit. Not a secret.
  verificationRef      String?
  revokedAt            DateTime?   @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One address belongs to at most one app user per network.
  @@unique([network, address])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Events and inventory
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  sellerId    String      @db.Uuid
  title       String
  description String      @default("")
  startsAt    DateTime    @db.Timestamptz(3)
  endsAt      DateTime?   @db.Timestamptz(3)
  venue       String
  city        String
  /// Event category chosen by the seller (XRPL-015), filterable in discovery (XRPL-059).
  /// Null for events created before the field existed. The allowed values are defined by the events
  /// contract (src/contracts/events.ts, Agent C); the database only enforces a trimmed, 1–40 character value.
  category    String?
  status      EventStatus @default(DRAFT)
  artworkUrl  String?
  publishedAt DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  seller            User               @relation("EventSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  tiers             TicketTier[]
  tickets           TicketNFT[]
  checkInChallenges CheckInChallenge[]
  checkIns          CheckInRecord[]
  reviews           Review[]
  products          PhysicalProduct[]

  @@index([status, startsAt])
  /// Discovery filter (XRPL-059): published events of a category, soonest first.
  @@index([status, category, startsAt])
  @@index([sellerId])
}

model TicketTier {
  id                String   @id @default(uuid()) @db.Uuid
  eventId           String   @db.Uuid
  name              String
  description       String   @default("")
  /// Integer drops as a decimal string, e.g. "2500000" (= 2.5 XRP).
  priceDrops        String
  /// `priceDrops` as a number, for price filters and sorting in queries (XRPL-059): compared as
  /// strings, "9" > "10". The database keeps it equal to `priceDrops` (trigger
  /// "TicketTier_price_drops_numeric", CHECK "TicketTier_priceDropsNumeric_matches"): read it, never set it.
  priceDropsNumeric BigInt   @default(0)
  totalSupply       Int
  /// Number of tickets with a validated NFTokenMint (MintStatus.MINTED).
  mintedQuantity    Int      @default(0)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets TicketNFT[]

  @@unique([eventId, name])
  @@index([eventId])
  /// Price filter (XRPL-059): tiers at or below a price.
  @@index([priceDropsNumeric])
}

/// One row per intended ticket NFT. The row may exist before the mint is validated
/// (mintStatus PENDING/SUBMITTED); nftokenId is set only from a validated mint.
model TicketNFT {
  id                String     @id @default(uuid()) @db.Uuid
  eventId           String     @db.Uuid
  tierId            String     @db.Uuid
  /// 1-based serial within the tier.
  serial            Int
  /// On-ledger NFTokenID (64 hex). Unique; null until the mint is validated.
  nftokenId         String?    @unique
  issuerAddress     String?
  metadataUri       String?
  mintStatus        MintStatus @default(PENDING)
  mintTxHash        String?    @unique
  mintedAt          DateTime?  @db.Timestamptz(3)
  /// Validated primary-sale acceptance. Drives primary sell-out (XRPL-020/032).
  primarySoldAt     DateTime?  @db.Timestamptz(3)
  primarySaleTxHash String?    @unique

  // --- Cached ownership: NOT authoritative. Re-read XRPL before any transfer/check-in. ---
  cachedOwnerAddress   String?
  ownerSyncStatus      SyncStatus @default(UNSYNCED)
  ownerSyncedAt        DateTime?  @db.Timestamptz(3)
  ownerSyncLedgerIndex Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tier              TicketTier         @relation(fields: [tierId], references: [id], onDelete: Restrict)
  offers            NFTOffer[]
  checkInChallenges CheckInChallenge[]
  checkIns          CheckInRecord[]

  @@unique([tierId, serial])
  @@index([eventId])
  @@index([cachedOwnerAddress])
}

// ---------------------------------------------------------------------------
// Offers and ledger transactions
// ---------------------------------------------------------------------------

/// Mirror of an XRPL NFT sell offer. The ledger object (offerIndex) is authoritative.
model NFTOffer {
  id                 String     @id @default(uuid()) @db.Uuid
  ticketId           String?    @db.Uuid
  nftokenId          String
  /// On-ledger nft_offer_index (64 hex). Null until NFTokenCreateOffer is validated.
  offerIndex         String?    @unique
  kind               OfferKind
  state              OfferState @default(PENDING_SIGNATURE)
  ownerAddress       String
  /// Set for PRIVATE and GIFT offers (XRPL Destination field).
  destinationAddress String?
  /// Integer drops as a decimal string. "0" only for GIFT.
  amountDrops        String
  expiresAt          DateTime?  @db.Timestamptz(3)
  createTxHash       String?    @unique
  acceptTxHash       String?
  cancelTxHash       String?
  /// Account that accepted the offer, from validated tx metadata (never from the client).
  acceptedByAddress  String?
  createdByUserId    String?    @db.Uuid
  lastSyncedAt       DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  ticket    TicketNFT? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("OfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([nftokenId])
  @@index([ticketId, state])
  @@index([kind, state])
}

/// Every XRPL transaction the app asked a wallet to sign or observed while reconciling.
/// `appliedAt` makes reconciliation idempotent: effects are applied once per hash.
model LedgerTransaction {
  id              String         @id @default(uuid()) @db.Uuid
  /// Null while only a sign request exists (hash not yet known).
  hash            String?        @unique
  type            LedgerTxType
  network         XrplNetwork    @default(TESTNET)
  account         String?
  status          LedgerTxStatus @default(PENDING)
  /// Engine result, e.g. tesSUCCESS, tecNO_PERMISSION.
  resultCode      String?
  ledgerIndex     Int?
  validatedAt     DateTime?      @db.Timestamptz(3)
  /// Set when the app has applied this tx's effects to its own tables.
  appliedAt       DateTime?      @db.Timestamptz(3)
  /// Wallet provider sign request / payload id (e.g. Xaman payload uuid).
  signRequestRef  String?        @unique
  relatedTicketId String?        @db.Uuid
  relatedOfferId  String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([relatedTicketId])
  @@index([relatedOfferId])
}

// ---------------------------------------------------------------------------
// Check-in
// ---------------------------------------------------------------------------

/// Short-lived, single-use challenge shown as a QR at the gate (XRPL-044/045).
model CheckInChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  nonce          String    @unique
  ticketId       String    @db.Uuid
  eventId        String    @db.Uuid
  walletAddress  String
  expiresAt      DateTime  @db.Timestamptz(3)
  consumedAt     DateTime? @db.Timestamptz(3)
  /// Reference to the wallet-signed proof (provider payload id / signature hash).
  proofReference String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  ticket  TicketNFT      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIn CheckInRecord?

  @@index([ticketId])
  @@index([eventId, expiresAt])
}

/// Exactly one admission per ticket per event, enforced by the unique index.
model CheckInRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  ticketId            String   @db.Uuid
  eventId             String   @db.Uuid
  organiserId         String   @db.Uuid
  challengeId         String?  @unique @db.Uuid
  walletAddress       String
  scannedAt           DateTime @default(now()) @db.Timestamptz(3)
  /// Ledger index at which ownership was verified for this admission.
  verifiedLedgerIndex Int?

  ticket    TicketNFT         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  organiser User              @relation("CheckInOrganiser", fields: [organiserId], references: [id], onDelete: Restrict)
  challenge CheckInChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  /// The review this admission vouches for, if any (XRPL-079).
  review    Review?

  @@unique([ticketId, eventId])
  @@index([eventId, scannedAt])
}

// ---------------------------------------------------------------------------
// Reviews (XRPL-079; API and UI by Agent D)
// ---------------------------------------------------------------------------

/// An event review. Only attendees may review: the API links the author's check-in.
/// The database guarantees one review per author per event, one review per check-in, a
/// linked check-in for the same event (trigger "Review_checkin_same_event"), a 1-5 rating
/// and a body of at most 2000 characters. Whether the author really attended (the check-in's
/// wallet is theirs) is checked by the API.
model Review {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @db.Uuid
  authorId        String    @db.Uuid
  /// 1 to 5 (CHECK Review_rating_range).
  rating          Int
  /// Up to 2000 characters (CHECK Review_body_length). May be empty.
  body            String    @default("")
  /// The check-in that proves the author attended. One review per check-in.
  checkInRecordId String?   @unique @db.Uuid
  /// Set when a moderator hides the review. Hidden reviews are not shown publicly.
  hiddenAt        DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author        User           @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Restrict: the proof behind a review can't silently disappear.
  checkInRecord CheckInRecord? @relation(fields: [checkInRecordId], references: [id], onDelete: Restrict)

  @@unique([eventId, authorId])
  @@index([eventId, createdAt])
}

// ---------------------------------------------------------------------------
// Friends (XRPL-084): opt-in connections between users, and blocks
// ---------------------------------------------------------------------------

enum FriendStatus {
  PENDING
  ACCEPTED
}

/// A friend request (PENDING) or friendship (ACCEPTED) between two users (XRPL-084). Declining or
/// removing deletes the row. Stored once per pair, lower ID first (CHECK FriendConnection_pair_order),
/// so A→B and B→A can't both exist and nobody befriends themselves. The requester is one of the pair
/// (CHECK FriendConnection_requester_in_pair), and respondedAt is set exactly when the request is
/// accepted (CHECK FriendConnection_responded_when_accepted).
model FriendConnection {
  id            String       @id @default(uuid()) @db.Uuid
  /// The pair, lower ID first: Postgres orders UUIDs as their lowercase text sorts.
  userLowId     String       @db.Uuid
  userHighId    String       @db.Uuid
  /// Who sent the request: userLowId or userHighId.
  requestedById String       @db.Uuid
  status        FriendStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  /// When the request was accepted. Null while PENDING.
  respondedAt   DateTime?    @db.Timestamptz(3)

  userLow  User @relation("FriendLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId])
}

/// blockerId blocked blockedId: no friend requests either way, and any connection between them is
/// deleted (XRPL-084). One block per direction; nobody can block themselves (CHECK UserBlock_not_self).
model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ---------------------------------------------------------------------------
// Commerce (XRPL-064): physical merchandise. Ordinary goods, not NFTs.
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Physical merchandise sold by a seller (XRPL-064). Ordinary goods, not NFTs: no ledger identifiers.
/// The database guarantees a positive drops price (CHECK PhysicalProduct_priceDrops_positive),
/// non-negative stock (PhysicalProduct_stock_nonnegative), at most 6 images
/// (PhysicalProduct_images_limit), a publish date once published (PhysicalProduct_published_has_date)
/// and, when linked to an event, that it is the seller's own event (trigger
/// "PhysicalProduct_event_same_seller").
model PhysicalProduct {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @db.Uuid
  /// Optional link to one of the seller's own events (e.g. a tour shirt).
  eventId     String?       @db.Uuid
  name        String
  description String        @default("")
  /// Integer drops as a decimal string, above zero.
  priceDrops  String
  /// https image URLs; the first is the cover. At most 6.
  imageUrls   String[]      @default([])
  /// Units available to sell. Never negative.
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  seller User   @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([sellerId, status, createdAt])
  /// Merchandise for an event page, and unlinking products when an event is deleted.
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Request idempotency for retriable mutations (mint / purchase / check-in)
// ---------------------------------------------------------------------------

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  /// Client-supplied Idempotency-Key header value.
  key            String
  /// Authenticated user, or a stable system scope for internal jobs.
  scope          String
  /// e.g. "POST /api/events/:id/mints"
  route          String
  /// Hash of the normalised request body; a reused key with a different body is rejected.
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  @@unique([scope, route, key])
  @@index([expiresAt])
}
